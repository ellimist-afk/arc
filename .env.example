# Copy to .env and fill in. main.py loads .env on startup.
# Lines left commented out use the default shown.

# --- Required -----------------------------------------------------------

# OpenAI: TTS and screen vision always use it; chat does too unless
# LLM_API_KEY/LLM_BASE_URL below are set.
OPENAI_API_KEY=

# Twitch app (https://dev.twitch.tv/console) and the bot account's token.
# get_twitch_tokens.py walks you through getting the tokens.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_BOT_USERNAME=
# Channel to join (your channel name, lowercase)
TWITCH_CHANNEL=
AUTO_START_CHANNEL=

# Postgres for viewer memory
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/streambot

# --- Twitch, optional ---------------------------------------------------

# Your own (broadcaster) account's token and user id, for features Twitch
# only grants the channel owner, such as ad-break events and clips.
# TWITCH_BROADCASTER_TOKEN=
# TWITCH_BROADCASTER_ID=

# --- Chat model, optional -----------------------------------------------

# A separate OpenAI-compatible chat endpoint (OpenRouter, LM Studio, vLLM,
# Ollama...). Both must be set; TTS and vision stay on OpenAI.
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Or point the OpenAI client itself somewhere else (chat only):
# OPENAI_BASE_URL=

# --- Voice --------------------------------------------------------------

# TTS_ENABLED=true
# VOICE_ENABLED=true
# VOICE_INPUT_ENABLED=true
# whisper = local faster-whisper (GPU); google = legacy cloud recognition
# VOICE_ASR_ENGINE=whisper
# WHISPER_MODEL=small.en
# legacy = Whisper -> LLM -> TTS; realtime = OpenAI Realtime speech-to-speech
# VOICE_BACKEND=legacy
# REALTIME_MODEL=gpt-realtime-2.1-mini
# REALTIME_VOICE=marin
# REALTIME_INPUT_DEVICE=
# REALTIME_OUTPUT_DEVICE=

# --- Dashboard ----------------------------------------------------------

# The dashboard has no login. It listens on 127.0.0.1 and only accepts
# requests from its own page. Widen these only on a network you trust.
API_ENABLED=true
# API_PORT=8000
# API_HOST=127.0.0.1
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Misc ---------------------------------------------------------------

# REDIS_URL=redis://localhost:6379
# LOG_LEVEL=INFO
# DEBUG=false
